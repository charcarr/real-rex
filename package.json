{
  "name": "real-rex",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Send your five best spots.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "web": "npm run dev --workspace @real-rex/web",
    "mobile": "npm run start --workspace @real-rex/mobile",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,sql,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,sql,yml,yaml}\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff -f",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts",
    "db:lint": "supabase db lint --level warning",
    "ios": "npm run ios --workspace @real-rex/mobile"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~6.0.3"
  }
}
