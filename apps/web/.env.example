# Copy to .env.local and fill in. Never commit it — this repository is public.
#
# NEXT_PUBLIC_* variables are exposed to the browser. Only publishable keys.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# PostHog. EU cloud.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Canonical origin, used for OG tags and absolute share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
