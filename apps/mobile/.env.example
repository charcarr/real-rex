# Copy to .env and fill in. Never commit .env — this repository is public.
#
# EXPO_PUBLIC_* variables are inlined into the app bundle at build time, so
# they are readable by anyone who downloads the app. Only ever put publishable
# keys here. Anything secret belongs in an EAS secret or on the server.

# Supabase project URL and publishable (anon) key.
# The anon key is safe to ship: it grants exactly what row-level security
# permits and nothing more. RLS is the security boundary, not this key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PostHog. EU cloud — note the host, most tutorials show the US one.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Base URL used to build shareable list links.
EXPO_PUBLIC_WEB_URL=http://localhost:3000
